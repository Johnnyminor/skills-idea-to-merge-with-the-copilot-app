---
---
<section class="bookmark-manager" aria-label="Bookmark manager">
  <form id="add-bookmark">
    <div class="field">
      <label for="url">Link to save</label>
      <input
        id="url"
        name="url"
        type="text"
        inputmode="url"
        autocomplete="url"
        spellcheck="false"
        placeholder="example.com"
        required
      />
    </div>
    <button type="submit">Add bookmark</button>
  </form>

  <p class="hint">Add a link with or without <code>https://</code> to create a short <code>mona-</code> slug.</p>
  <p id="bookmark-status" class="status" role="status" aria-live="polite"></p>

  <p id="empty-state" class="empty">No bookmarks yet. Add your first favorite link above.</p>

  <div id="list-header" class="list-header" hidden>
    <h2 class="list-title">Saved bookmarks</h2>
    <button id="clear-all" type="button" class="clear">Clear all</button>
  </div>

  <ul id="bookmark-list" aria-label="Saved bookmarks" aria-live="polite"></ul>
</section>

<style>
  .bookmark-manager {
    padding: 1.25rem;
    border: 1px solid var(--border);
    border-radius: 1rem;
    background: color-mix(in srgb, currentColor 3%, transparent);
    box-shadow: 0 1rem 2.5rem color-mix(in srgb, currentColor 6%, transparent);
  }

  .bookmark-manager form { margin-top: 0; }
  .bookmark-manager input { min-width: 0; }
  .bookmark-manager input::placeholder { color: var(--muted); }
  .bookmark-manager .hint { margin-bottom: 1rem; }
  .bookmark-manager .status {
    min-height: 1.25rem;
    margin: -0.5rem 0 0.75rem;
    color: var(--muted);
    font-size: 0.8rem;
  }
  .bookmark-manager .status[data-error="true"] { color: #dc2626; }
  .bookmark-manager .list-header { margin-top: 1.25rem; }
  .bookmark-manager :global(.bookmark) {
    background: color-mix(in srgb, currentColor 2%, transparent);
  }
  .bookmark-manager :global(.separator) { white-space: pre; color: var(--muted); }
  .bookmark-manager :global(.url) { overflow-wrap: anywhere; }
  .bookmark-manager :global(.slug) { font-family: var(--font-body); }
  .bookmark-manager .empty { margin-top: 1rem; }

  @media (max-width: 30rem) {
    .bookmark-manager { padding: 1rem; }
    .bookmark-manager form button { width: 100%; }
  }
</style>

<script>
  import { createSlug, formatBookmark, normalizeUrl, parseBookmarks } from '../lib/bookmarks.js';

  const STORAGE_KEY = 'mona-bookmarks';
  const form = document.getElementById('add-bookmark');
  const urlInput = document.getElementById('url');
  const list = document.getElementById('bookmark-list');
  const emptyState = document.getElementById('empty-state');
  const listHeader = document.getElementById('list-header');
  const status = document.getElementById('bookmark-status');

  if (
    form instanceof HTMLFormElement &&
    urlInput instanceof HTMLInputElement &&
    list instanceof HTMLUListElement &&
    emptyState instanceof HTMLElement &&
    listHeader instanceof HTMLElement &&
    status instanceof HTMLElement
  ) {
    const showStatus = (message, isError = false) => {
      status.textContent = message;
      status.dataset.error = String(isError);
    };

    const readStoredBookmarks = () => {
      try {
        return parseBookmarks(localStorage.getItem(STORAGE_KEY));
      } catch {
        showStatus('Browser storage is unavailable. Bookmarks will stay only for this visit.', true);
        return [];
      }
    };

    let bookmarks = readStoredBookmarks();

    const saveBookmarks = () => {
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(bookmarks));
        return true;
      } catch {
        showStatus('Could not save to browser storage. Your changes will not survive a reload.', true);
        return false;
      }
    };

    const renderBookmarks = () => {
      list.replaceChildren();
      emptyState.hidden = bookmarks.length > 0;
      listHeader.hidden = bookmarks.length === 0;

      for (const bookmark of bookmarks) {
        const row = document.createElement('li');
        row.className = 'bookmark';

        const link = document.createElement('a');
        link.className = 'url';
        link.href = bookmark.url;
        link.target = '_blank';
        link.rel = 'noopener noreferrer';
        link.textContent = bookmark.url;

        const separator = document.createElement('span');
        separator.className = 'separator';
        separator.textContent = ' :: ';

        const slug = document.createElement('code');
        slug.className = 'slug';
        slug.textContent = bookmark.slug;

        const copy = document.createElement('button');
        copy.className = 'copy';
        copy.type = 'button';
        copy.textContent = 'Copy';
        copy.setAttribute('aria-label', `Copy ${bookmark.slug}`);
        copy.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(bookmark.slug);
            showStatus(`Copied ${bookmark.slug}.`);
          } catch {
            showStatus('Could not copy the slug. Select and copy it instead.', true);
          }
        });

        row.append(link, separator, slug, copy);
        row.setAttribute('aria-label', formatBookmark(bookmark));
        list.append(row);
      }
    };

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      try {
        const url = normalizeUrl(urlInput.value);
        let slug = createSlug();
        const existingSlugs = new Set(bookmarks.map((bookmark) => bookmark.slug));
        while (existingSlugs.has(slug)) {
          slug = createSlug();
        }

        bookmarks = [...bookmarks, { url, slug }];
        const saved = saveBookmarks();
        renderBookmarks();
        urlInput.value = '';
        if (saved) {
          showStatus(`Saved ${formatBookmark({ url, slug })}.`);
        }
      } catch (error) {
        showStatus(error instanceof Error ? error.message : 'Could not add that bookmark.', true);
      }
    });

    document.getElementById('clear-all')?.addEventListener('click', () => {
      if (!window.confirm('Clear all saved bookmarks from this device?')) {
        return;
      }

      bookmarks = [];
      let cleared = true;
      try {
        localStorage.removeItem(STORAGE_KEY);
      } catch {
        cleared = false;
      }
      renderBookmarks();
      showStatus(
        cleared ? 'All bookmarks cleared.' : 'Bookmarks cleared for this visit, but browser storage could not be updated.',
        !cleared,
      );
    });

    renderBookmarks();
  }
</script>
